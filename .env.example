# Native commands need these exported; Compose automatically reads .env.
APP_ENV=development
DATABASE_URL=sqlite:///./assistant.db
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Use URL-safe random strings (for example: openssl rand -hex 24).
POSTGRES_PASSWORD=
DEMO_PASSWORD=
# Optional local embeddings; install the reviewed model in Ollama first.
OLLAMA_EMBED_MODEL=
# Installer configures these automatically; leave blank for local-only access.
APP_DOMAIN=
APP_PORT=8000
# Generated automatically by the wizard. Preserve this key with encrypted provider data.
PROVIDER_SECRET_KEY=
AI_PROVIDER=ollama
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# Comma-separated operator-approved custom base URLs; redirects are never followed.
AI_CUSTOM_BASE_URLS=
AI_MAX_OUTPUT_TOKENS=1024
AI_TOKEN_PARAMETER=max_tokens
